{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Oppskrift",
  "type": "object",
  "required": ["id", "title", "category", "servings", "time", "status", "source", "ingredients", "steps"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Samme som filnavnet" },
    "title": { "type": "string" },
    "category": { "type": "string", "description": "Mexicansk, Pizza og brød, Bakst, Pasta, Fast food, Asiatisk, One pan, Saus og tilbehør, Dessert ..." },
    "emoji": { "type": "string", "description": "Plassholder til ekte bilde er på plass" },
    "image": { "type": ["string", "null"], "description": "Relativ sti, f.eks. data/images/birria-taco.webp" },
    "imagePos": { "type": "string", "description": "Valgfritt utsnitt på forsiden (CSS object-position), f.eks. \"50% 70%\"" },
    "servings": { "type": "string", "description": "F.eks. '4 personer'" },
    "time": {
      "type": "object",
      "properties": { "active": { "type": "integer", "description": "Minutter aktivt arbeid" }, "total": { "type": "integer", "description": "Minutter totalt inkl. heving/hvile" } }
    },
    "status": { "enum": ["kladd", "testet"] },
    "source": {
      "type": "object", "required": ["type"],
      "properties": { "type": { "enum": ["egen", "nettside", "tiktok", "youtube"] }, "url": { "type": "string" } }
    },
    "intro": { "type": "string" },
    "headsUp": { "type": "string", "description": "Ting man må starte i god tid, f.eks. kaldheving" },
    "tips": { "type": "array", "items": { "type": "string" } },
    "uses": { "type": "array", "items": { "type": "string" }, "description": "id-er til grunnoppskrifter denne retten bruker" },
    "pairs": {
      "type": "object",
      "description": "Verdier kan være id til en annen rett (blir lenke) eller fri tekst",
      "properties": {
        "drink": { "type": "array", "items": { "type": "string" } },
        "starter": { "type": "array", "items": { "type": "string" } },
        "side": { "type": "array", "items": { "type": "string" } },
        "dessert": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ingredients": {
      "type": "array",
      "items": {
        "type": "object", "required": ["name"],
        "properties": {
          "group": { "type": "string" },
          "name": { "type": "string" },
          "qty": { "type": ["string", "null"], "description": "null = mengde mangler (vises tydelig i appen)" },
          "optional": { "type": "boolean", "description": "Kan sløyfes" },
          "spicy": { "type": "boolean", "description": "Sterk – byttes/fjernes i mild versjon" },
          "alt": { "type": "object", "properties": { "name": { "type": "string" }, "qty": { "type": "string" } } },
          "note": { "type": "string" }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object", "required": ["text"],
        "properties": {
          "text": { "type": "string" },
          "note": { "type": "string" },
          "anim": { "enum": ["chop", "season", "fry", "boil", "stir", "bake", "knead", "rest", "assemble", "serve", "none"] },
          "icon": { "type": "string", "description": "Emoji som plassholder" },
          "image": { "type": ["string", "null"] },
          "video": { "type": ["string", "null"] },
          "timer": { "type": "integer", "description": "Minutter" },
          "ingredients": {
            "type": "array",
            "description": "Ingrediensene steget bruker. Appen viser dem med mengde under instruksjonen («Du trenger»). Mengden hentes fra ingredienslisten, så tallene står bare ett sted. Før opp en ingrediens i det steget der den først måles opp.",
            "items": {
              "oneOf": [
                { "type": "string", "description": "Navnet nøyaktig slik det står i ingredienslisten" },
                {
                  "type": "object", "required": ["name"], "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string", "description": "Navnet nøyaktig slik det står i ingredienslisten" },
                    "group": { "type": "string", "description": "Gruppen, når samme navn står i flere grupper (f.eks. smør i både deig og fyll)" },
                    "qty": { "type": "string", "description": "Egen mengde når steget bare bruker en del, f.eks. «150 g» eller «3 ss»" },
                    "label": { "type": "string", "description": "Kortere navn å vise i steget" }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
